<?xml version="1.0"?>
<widget id="org.potion.app" version="0.3.0" viewmodes="application"
 xmlns="http://www.w3.org/ns/widgets" xmlns:kindle="http://kindle.amazon.com/ns/widget-extensions">
 <name xml:lang="en">Potion</name><description xml:lang="en">Notion reader for Kindle</description>
 <content src="index.html"/>
 <kindle:permissions><kindle:permission name="local-port-access"/></kindle:permissions>
 <kindle:network><kindle:asset key="initialDNS" value="false"/><kindle:asset key="maxConnections" value="2"/><kindle:asset key="maxConnectionsPerHost" value="2"/><kindle:asset key="overrideProxy" value="none"/><kindle:asset key="enableCaching" value="false"/></kindle:network>
 <kindle:chrome><kindle:asset key="configureSearchBar" value="none"/></kindle:chrome>
 <kindle:gestures><kindle:param name="pinchzoom" value="no"/><kindle:param name="tap" value="no"/><kindle:param name="multi_tap" value="no"/><kindle:param name="hold" value="no"/></kindle:gestures>
 <feature name="http://kindle.amazon.com/apis" required="true"><param name="appmgr" value="yes"/><param name="gestures" value="yes"/><param name="chrome" value="yes"/><param name="device" value="yes"/></feature>
 <kindle:settings><kindle:setting name="internetRequired" value="yes"/><kindle:setting name="saveContext" value="no"/></kindle:settings>
</widget>
