set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR armv7l)
if(NOT DEFINED ENV{KINDLE_SDK_ROOT})
  message(FATAL_ERROR "KINDLE_SDK_ROOT is required")
endif()
set(POTION_SDK "$ENV{KINDLE_SDK_ROOT}")
set(POTION_TRIPLET arm-linux-gnueabi)
set(CMAKE_SYSROOT "${POTION_SDK}/armel")
set(CMAKE_C_COMPILER "${POTION_SDK}/bin/${POTION_TRIPLET}-gcc")
set(CMAKE_CXX_COMPILER "${POTION_SDK}/bin/${POTION_TRIPLET}-g++")
set(CMAKE_AR "${POTION_SDK}/bin/${POTION_TRIPLET}-ar")
set(CMAKE_RANLIB "${POTION_SDK}/bin/${POTION_TRIPLET}-ranlib")
set(CMAKE_STRIP "${POTION_SDK}/bin/${POTION_TRIPLET}-strip")
set(CMAKE_C_FLAGS_INIT "-march=armv7-a -mfpu=neon -mfloat-abi=softfp")
set(CMAKE_CXX_FLAGS_INIT "-march=armv7-a -mfpu=neon -mfloat-abi=softfp")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${CMAKE_SYSROOT}")
set(ENV{PKG_CONFIG_LIBDIR} "${CMAKE_SYSROOT}/usr/lib/pkgconfig:${CMAKE_SYSROOT}/usr/share/pkgconfig")
